# API base URL. Leave empty to call the API on the same origin ("/api"),
# which is proxied to https://ts.idicorp.ir by the Vite dev server and by the
# Netlify edge function. Set a full URL to call the service directly
# (then the service must allow your origin with credentials via CORS).
VITE_API_BASE_URL=

# WebSocket base URL (WebSockets connect directly; they do not use cookies).
VITE_WS_BASE_URL=wss://ts.idicorp.ir
